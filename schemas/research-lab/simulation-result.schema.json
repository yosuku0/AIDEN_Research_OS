{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/research-lab/simulation-result.schema.json",
  "type": "object",
  "required": [
    "id",
    "simulation_type",
    "hypothesis",
    "result",
    "confidence",
    "methodology",
    "timestamp"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^SR-[0-9]+$"
    },
    "simulation_type": {
        "type": "string",
        "enum": [
            "dex-liquidity",
            "perp-funding",
            "prediction-market",
            "mcp-permission",
            "approval-workflow"
        ]
    },
    "hypothesis": {
        "type": "string"
    },
    "result": {
        "type": "string"
    },
    "confidence": {
        "type": "string",
        "enum": [
            "high",
            "medium",
            "low"
        ]
    },
    "methodology": {
        "type": "string"
    },
    "timestamp": {
        "type": "string",
        "format": "date-time"
    },
    "data_summary": {
        "type": "string"
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}