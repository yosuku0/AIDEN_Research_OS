{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/research-lab/evidence-bundle.schema.json",
  "type": "object",
  "required": [
    "id",
    "lab",
    "evidence_type",
    "summary",
    "sources",
    "timestamp"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^EB-[0-9]+$"
    },
    "lab": {
        "type": "string",
        "enum": [
            "base-dex-lab",
            "perp-dex-lab",
            "prediction-market-lab"
        ]
    },
    "evidence_type": {
        "type": "string",
        "enum": [
            "on-chain-data",
            "simulation",
            "survey",
            "literature"
        ]
    },
    "summary": {
        "type": "string"
    },
    "sources": {
        "type": "array",
        "items": {
            "type": "string"
        }
    },
    "timestamp": {
        "type": "string",
        "format": "date-time"
    },
    "data_quality": {
        "type": "string",
        "enum": [
            "verified",
            "unverified",
            "simulated"
        ]
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}