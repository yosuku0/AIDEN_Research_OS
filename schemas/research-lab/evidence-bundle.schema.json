{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "evidence_items",
    "redaction_status",
    "reviewer"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_status": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "linked_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
