{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "actor",
    "event",
    "governance_policy",
    "result"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_trace": {
      "type": "string"
    },
    "governance_policy": {
      "type": "string",
      "minLength": 1
    },
    "approval_reference": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "minLength": 1
    }
  }
}
