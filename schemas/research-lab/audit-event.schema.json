{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/research-lab/audit-event.schema.json",
  "type": "object",
  "required": [
    "id",
    "event_type",
    "actor",
    "timestamp",
    "resource",
    "action",
    "outcome"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^AE-[0-9]+$"
    },
    "event_type": {
        "type": "string",
        "enum": [
            "access",
            "modification",
            "approval",
            "rejection",
            "scan",
            "validation"
        ]
    },
    "actor": {
        "type": "string"
    },
    "timestamp": {
        "type": "string",
        "format": "date-time"
    },
    "resource": {
        "type": "string"
    },
    "action": {
        "type": "string"
    },
    "outcome": {
        "type": "string",
        "enum": [
            "success",
            "failure",
            "blocked"
        ]
    },
    "details": {
        "type": "string"
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}