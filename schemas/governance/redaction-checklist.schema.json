{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/redaction-checklist.schema.json",
  "type": "object",
  "required": [
    "id",
    "scope",
    "pr_id",
    "secret_free",
    "source_free",
    "prompt_free",
    "output_free",
    "log_free",
    "identity_preserved",
    "legal_verified",
    "finalized_at"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^RC-[0-9]+$"
    },
    "scope": {
        "type": "string"
    },
    "pr_id": {
        "type": "string"
    },
    "secret_free": {
        "type": "boolean"
    },
    "source_free": {
        "type": "boolean"
    },
    "prompt_free": {
        "type": "boolean"
    },
    "output_free": {
        "type": "boolean"
    },
    "log_free": {
        "type": "boolean"
    },
    "identity_preserved": {
        "type": "boolean"
    },
    "legal_verified": {
        "type": "boolean"
    },
    "finalized_at": {
        "type": "string"
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}