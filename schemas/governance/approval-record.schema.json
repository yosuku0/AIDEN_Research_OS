{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "approval_type",
    "requested_by",
    "approver",
    "approval_scope",
    "decision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "approval_type": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "approval_scope": {
      "type": "string",
      "minLength": 1
    },
    "linked_pr": {
      "type": "string"
    },
    "linked_phase_gate": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "edit",
        "reject",
        "hold",
        "pending"
      ]
    },
    "conditions": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  }
}
