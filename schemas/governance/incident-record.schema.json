{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/incident-record.schema.json",
  "type": "object",
  "required": [
    "id",
    "scope",
    "finding_id",
    "description",
    "severity",
    "detected_at",
    "reported_by",
    "status",
    "resolution_plan",
    "resolved_at",
    "resolution_summary",
    "approver"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^INC-[0-9]+$"
    },
    "scope": {
        "type": "string"
    },
    "finding_id": {
        "type": "string",
        "pattern": "^H-[0-9]+$|^INC-[0-9]+$"
    },
    "description": {
        "type": "string"
    },
    "severity": {
        "type": "string",
        "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
        ]
    },
    "detected_at": {
        "type": "string",
        "format": "date-time"
    },
    "reported_by": {
        "type": "string"
    },
    "status": {
        "type": "string",
        "enum": [
            "open",
            "resolved"
        ]
    },
    "resolution_plan": {
        "type": "string"
    },
    "resolved_at": {
        "type": "string"
    },
    "resolution_summary": {
        "type": "string"
    },
    "approver": {
        "type": "string"
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}