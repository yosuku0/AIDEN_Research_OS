{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/phase-gate-record.schema.json",
  "type": "object",
  "required": [
    "id",
    "phase",
    "decision",
    "justification",
    "approver",
    "linked_pr",
    "evidence_links",
    "conditions",
    "timestamp"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^PG-[0-9]+$"
    },
    "phase": {
        "type": "string"
    },
    "decision": {
        "type": "string",
        "enum": [
            "go",
            "no-go",
            "hold"
        ]
    },
    "justification": {
        "type": "string"
    },
    "approver": {
        "type": "string"
    },
    "linked_pr": {
        "type": "string"
    },
    "evidence_links": {
        "type": "string"
    },
    "conditions": {
        "type": "string"
    },
    "timestamp": {
        "type": "string"
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}