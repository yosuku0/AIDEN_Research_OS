{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "decision",
    "justification",
    "approver"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "go",
        "no-go",
        "hold",
        "pending"
      ]
    },
    "justification": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "linked_pr": {
      "type": "string"
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  }
}
