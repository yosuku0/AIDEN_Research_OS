{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "status",
    "blocker",
    "related_adr",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "blocker": {
      "type": "string"
    },
    "related_adr": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "next_review": {
      "type": "string"
    }
  }
}
