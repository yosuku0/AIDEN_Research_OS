{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/open-questions.schema.json",
  "type": "object",
  "required": [
    "id",
    "question",
    "context",
    "status",
    "owner",
    "linked_adr"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^OQ-[0-9]+$"
    },
    "question": {
        "type": "string"
    },
    "context": {
        "type": "string"
    },
    "status": {
        "type": "string",
        "enum": [
            "open",
            "closed",
            "deferred"
        ]
    },
    "owner": {
        "type": "string"
    },
    "linked_adr": {
        "type": "string"
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}