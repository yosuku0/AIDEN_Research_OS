{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/task-promotion-record.schema.json",
  "type": "object",
  "required": [
    "id",
    "research_source",
    "codex_task",
    "promotion_criteria",
    "redaction_status",
    "approval_reference",
    "status"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^TP-[0-9]+$"
    },
    "research_source": {
        "type": "string"
    },
    "codex_task": {
        "type": "string"
    },
    "promotion_criteria": {
        "type": "string"
    },
    "redaction_status": {
        "type": "string"
    },
    "approval_reference": {
        "type": "string"
    },
    "status": {
        "type": "string",
        "enum": [
            "draft",
            "ready_for_review",
            "approved",
            "rejected"
        ]
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}