{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiden-research-os/schemas/risk-ledger.schema.json",
  "type": "object",
  "required": [
    "id",
    "risk",
    "impact",
    "likelihood",
    "mitigation",
    "owner",
    "status"
],
  "properties": {
    "id": {
        "type": "string",
        "pattern": "^RK-[0-9]+$"
    },
    "risk": {
        "type": "string"
    },
    "impact": {
        "type": "string",
        "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
        ]
    },
    "likelihood": {
        "type": "string",
        "enum": [
            "certain",
            "likely",
            "possible",
            "unlikely"
        ]
    },
    "mitigation": {
        "type": "string"
    },
    "owner": {
        "type": "string"
    },
    "status": {
        "type": "string",
        "enum": [
            "open",
            "mitigated",
            "accepted",
            "transferred"
        ]
    }
},
  "patternProperties": {
    "^x-[a-z0-9_-]+$": {
      "description": "Experimental extension field. Must start with x-. Must not contain credential values or local paths."
    }
  },
  "unevaluatedProperties": false
}